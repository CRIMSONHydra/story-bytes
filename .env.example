PORT=5001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/story_bytes
# Or individual DB params
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=story_bytes

# Google Cloud / Gemini
GOOGLE_SEARCH_API_KEY=your_search_api_key
GOOGLE_CX=your_search_engine_id
GEMINI_API_KEY=your_gemini_api_key

# Gemini model overrides (optional). Defaults track the current flash tier via -latest aliases,
# which survive model retirements. Pin explicit versions here only if you need reproducibility.
# GEMINI_MAIN_MODEL=gemini-flash-latest
# GEMINI_LITE_MODEL=gemini-flash-lite-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_MODEL_TAG=gemini-embedding-001   # block_embeddings.model tag retrieval matches (M9 D6)
