PORT=5001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/story_bytes
# Or individual DB params
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=story_bytes

# Google Cloud / Gemini
GOOGLE_SEARCH_API_KEY=your_search_api_key
GOOGLE_CX=your_search_engine_id
GEMINI_API_KEY=your_gemini_api_key

# Security / ops (M1). If ADMIN_TOKEN is set, /api/admin/* requires `Authorization: Bearer <token>`;
# if unset, admin routes are OPEN (a boot warning says so) — set it outside local dev.
# ADMIN_TOKEN=change-me
# LOG_LEVEL=info                # pino level (trace|debug|info|warn|error|fatal)

# Gemini model overrides (optional). DEMO-STAGE DEFAULT: both tiers are gemini-flash-lite-latest
# (full flash is too costly at demo volume). To restore the stronger main tier post-demo, set:
# GEMINI_MAIN_MODEL=gemini-flash-latest
# GEMINI_LITE_MODEL=gemini-flash-lite-latest
# Embeddings: gemini-embedding-2 (MRL, in-prompt task instruction, auto-normalized at truncated dims).
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_DIMS=1536                 # MRL size; must be <=2000 for pgvector HNSW indexing
# EMBEDDING_MODEL_TAG=gemini-embedding-2/1536  # block_embeddings.model tag retrieval matches
